# Gateway Service Configuration
# Copy this file to .env and modify as needed.
# cargo run does not load .env automatically; export variables or load it with local tooling.
# Copying this file is not process configuration.

# ============================================
# Operator catalog (non-secret)
# ============================================
# Version-1 JSON route/target/pricing catalog. Example model names and prices
# are illustrative samples, not current provider billing or availability.
OPMUX_CONFIG_FILE=config/opmux.example.json

# ============================================
# Server Configuration
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
# Graceful shutdown timeout in seconds
SERVER_SHUTDOWN_TIMEOUT=30

# ============================================
# Authentication Configuration
# ============================================
# Development Mode (NEVER enable in production)
# Set to true to bypass authentication for development/testing
AUTH_DEVELOPMENT_MODE=false

# Development Client ID (only used when AUTH_DEVELOPMENT_MODE=true)
# Customize the mock client ID used in development mode
AUTH_DEV_CLIENT_ID=dev-client-123

# Performance Monitoring
# Slow operation threshold in milliseconds
# Operations taking longer than this will be logged as warnings
# Default: 10ms (suitable for mock data, increase for database operations)
AUTH_SLOW_THRESHOLD_MS=10

# ============================================
# Logging Configuration
# ============================================
# Standard Rust tracing filter (default: info; overrides LOG_LEVEL)
# Example: RUST_LOG=gateway=debug,tower_http=info
RUST_LOG=gateway=info
# Log output format: json (default) or pretty; overrides LOG_JSON
LOG_FORMAT=pretty
# Legacy fallbacks, used only when the corresponding setting above is unset:
# LOG_LEVEL=info
# LOG_JSON=false
# Enable verbose debug logging options in development only
LOG_VERBOSE_DEBUG=false

# ============================================
# Metrics Configuration
# ============================================
# Enable Prometheus HTTP metrics endpoint
METRICS_ENABLED=true
# Metrics endpoint path
METRICS_PATH=/metrics

# Ingress slow request alert threshold in milliseconds
INGRESS_SLOW_REQUEST_THRESHOLD_MS=1000

# ============================================
# External Service URLs (gRPC)
# ============================================
# Router Service - AI model routing and selection
ROUTER_SERVICE_URL=http://localhost:50051

# Memory Service - Conversation context management
MEMORY_SERVICE_URL=http://localhost:50052

# Rewrite Service - Request rewriting and transformation
REWRITE_SERVICE_URL=http://localhost:50053

# Validation Service - Request validation
VALIDATION_SERVICE_URL=http://localhost:50054

# gRPC connection timeout in milliseconds
GRPC_CONNECTION_TIMEOUT_MS=5000

# gRPC request timeout in milliseconds
GRPC_REQUEST_TIMEOUT_MS=30000

# ============================================
# LLM Vendor API Keys (Executor Layer)
# ============================================
# OpenAI API Key (required for OpenAI models)
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Base URL (optional, default: https://api.openai.com/v1)
# Useful for proxies or custom endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Request Timeout (optional override of catalog max_attempt_timeout_ms, default 10000ms)
# OPENAI_TIMEOUT_MS=10000

# Optional canonical limit overrides (milliseconds/counts/bytes). Defaults:
# 30s protected deadline, 10s attempt timeout, 1 retry/target, 3 total attempts,
# max 2 fallbacks, 2s backoff cap. Validated now; not all are enforced yet.
# OPMUX_PROTECTED_REQUEST_DEADLINE_MS=30000
# OPMUX_MAX_ATTEMPT_TIMEOUT_MS=10000
# OPMUX_RETRIES_PER_TARGET=1
# OPMUX_MAX_TOTAL_ATTEMPTS=3
# OPMUX_MAX_FALLBACK_TARGETS=2
# OPMUX_BACKOFF_CAP_MS=2000

# Anthropic API Key (future support)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Executor Layer Configuration
# Request timeout in milliseconds (default: 30000)
EXECUTOR_TIMEOUT_MS=30000

# Maximum number of retries per target (optional override of retries_per_target, default: 1)
# EXECUTOR_MAX_RETRIES=1

# ============================================
# Health Check Configuration
# ============================================
# Health check timeout in seconds (default: 2)
HEALTH_CHECK_TIMEOUT=2

# Health check cache TTL in seconds (default: 5)
# Results are cached to avoid excessive API calls to vendor health endpoints
HEALTH_CHECK_CACHE_TTL_SECS=5

# ============================================
# Environment Profiles (Examples)
# ============================================
# Production profile:
# LOG_FORMAT=json
# RUST_LOG=gateway=info
# METRICS_ENABLED=true
# HEALTH_CHECK_TIMEOUT=2
# HEALTH_CHECK_CACHE_TTL_SECS=30

# Development profile:
# LOG_FORMAT=pretty
# RUST_LOG=gateway=debug
# LOG_VERBOSE_DEBUG=true
# METRICS_ENABLED=true

# Staging profile:
# LOG_FORMAT=json
# RUST_LOG=gateway=debug
# METRICS_ENABLED=true

# ============================================
# Production Settings
# ============================================
# AUTH_DEVELOPMENT_MODE should always be false or unset in production
# LOG_FORMAT should be json in production for structured logging
# Adjust timeouts based on your infrastructure requirements
# NEVER commit real API keys to version control
