# Gateway Service Configuration
# Copy this file to .env and modify as needed.
# cargo run does not load .env automatically; export variables or load it with local tooling.
# Copying this file is not process configuration.

# ============================================
# Operator catalog (non-secret)
# ============================================
# Version-1 JSON route/target/pricing catalog. Example model names and prices
# are illustrative samples, not current provider billing or availability.
OPMUX_CONFIG_FILE=config/opmux.example.json

# ============================================
# Server Configuration
# ============================================
# Native binary default is 0.0.0.0:3000 if these are unset. Local loopback
# examples and the documented container stack use 127.0.0.1:38080.
SERVER_HOST=127.0.0.1
SERVER_PORT=38080
# Graceful shutdown timeout in seconds
SERVER_SHUTDOWN_TIMEOUT=30

# ============================================
# Authentication Configuration
# ============================================
# Legacy flags. AUTH_DEVELOPMENT_MODE does not bypass authentication.
AUTH_DEVELOPMENT_MODE=false
# AUTH_DEV_CLIENT_ID is ignored; identity comes from the persisted key.
# AUTH_DEV_CLIENT_ID=dev-client-123

# ============================================
# Persistence (SQLx / local Supabase)
# ============================================
# Required for gateway bind, repository tests, scripts/db-migrate.sh, and opmux-admin.
# Local loopback example (do not commit real passwords):
# DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:55432/postgres?sslmode=disable
# Hosted: direct or session-mode pooler URL with sslmode=verify-full.
# Tests and mission migrations must wrap with scripts/with-owned-database.sh; that
# wrapper replaces inherited DATABASE_URL and does not restrict production URLs.
# Do not apply migrations from every running replica.
# opmux-admin SET ROLE target (default opmux_operator). Connecting user must be a member.
# OPMUX_DB_ROLE=opmux_operator
# OPMUX_DB_MAX_CONNECTIONS=10
# OPMUX_DB_ACQUIRE_TIMEOUT_MS=3000
# OPMUX_DB_STATEMENT_TIMEOUT_MS=5000

# Slow-auth warning threshold in milliseconds (logging only; not an auth bypass)
AUTH_SLOW_THRESHOLD_MS=10

# ============================================
# Logging Configuration
# ============================================
# Standard Rust tracing filter (default: info; overrides LOG_LEVEL)
# Example: RUST_LOG=gateway=debug,tower_http=info
RUST_LOG=gateway=info
# Log output format: json (default) or pretty; overrides LOG_JSON
LOG_FORMAT=pretty
# Legacy fallbacks, used only when the corresponding setting above is unset:
# LOG_LEVEL=info
# LOG_JSON=false
# Enable verbose debug logging options in development only
LOG_VERBOSE_DEBUG=false

# ============================================
# Metrics Configuration
# ============================================
# Enable Prometheus HTTP metrics endpoint
METRICS_ENABLED=true
# Metrics endpoint path
METRICS_PATH=/metrics

# Ingress slow request alert threshold in milliseconds
INGRESS_SLOW_REQUEST_THRESHOLD_MS=1000

# ============================================
# Deferred gRPC microservice URLs (unused)
# ============================================
# Historical template keys for Router/Memory/Rewrite/Validation services.
# The binary does not read these. Those microservices are not shipped.
# ROUTER_SERVICE_URL=http://localhost:50051
# MEMORY_SERVICE_URL=http://localhost:50052
# REWRITE_SERVICE_URL=http://localhost:50053
# VALIDATION_SERVICE_URL=http://localhost:50054
# GRPC_CONNECTION_TIMEOUT_MS=5000
# GRPC_REQUEST_TIMEOUT_MS=30000

# ============================================
# LLM Vendor API Keys (Executor Layer)
# ============================================
# Local stack uses a dummy key and the owned loopback simulator. This is not a
# paid provider configuration. The binary default for an unset OPENAI_BASE_URL
# is https://api.openai.com/v1; documented local commands always override it.
OPENAI_API_KEY=local-stack-dummy-only
OPENAI_BASE_URL=http://127.0.0.1:38081/v1

# Paid/compatible upstream (optional). Set BOTH values so the simulator URL is
# not retained. http or https path-prefix only; no userinfo, query, or fragment
# (including empty ?/#). Trailing slashes are stripped.
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Request Timeout (optional override of catalog max_attempt_timeout_ms, default 10000ms)
# OPENAI_TIMEOUT_MS=10000

# Optional canonical limit overrides (milliseconds/counts/bytes). Defaults:
# 30s protected deadline, 10s attempt timeout, 1 retry/target, 3 total attempts,
# max 2 fallbacks, 2s backoff cap. These are validated and enforced.
# OPMUX_PROTECTED_REQUEST_DEADLINE_MS=30000
# OPMUX_MAX_ATTEMPT_TIMEOUT_MS=10000
# OPMUX_RETRIES_PER_TARGET=1
# OPMUX_MAX_TOTAL_ATTEMPTS=3
# OPMUX_MAX_FALLBACK_TARGETS=2
# OPMUX_BACKOFF_CAP_MS=2000

# Anthropic is deferred. The binary does not call Anthropic.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional override of catalog max_attempt_timeout_ms (default 10000ms).
# EXECUTOR_TIMEOUT_MS=10000

# Maximum number of retries per target (optional override of retries_per_target, default: 1)
# EXECUTOR_MAX_RETRIES=1

# ============================================
# Health Check Configuration
# ============================================
# Health check timeout in seconds (default: 2)
HEALTH_CHECK_TIMEOUT=2

# Success-only health cache TTL in seconds (default: 5). Failures are never cached.
# There is no HEALTH_CHECK_MODE setting.
HEALTH_CHECK_CACHE_TTL_SECS=5

# ============================================
# Environment Profiles (Examples)
# ============================================
# Production-like logging profile (not a hosted deployment):
# LOG_FORMAT=json
# RUST_LOG=gateway=info
# METRICS_ENABLED=true
# HEALTH_CHECK_TIMEOUT=2
# HEALTH_CHECK_CACHE_TTL_SECS=5

# Development profile:
# LOG_FORMAT=pretty
# RUST_LOG=gateway=debug
# LOG_VERBOSE_DEBUG=true
# METRICS_ENABLED=true

# Staging profile:
# LOG_FORMAT=json
# RUST_LOG=gateway=debug
# METRICS_ENABLED=true

# ============================================
# Production Settings
# ============================================
# AUTH_DEVELOPMENT_MODE should always be false or unset in production
# LOG_FORMAT should be json in production for structured logging
# Adjust timeouts based on your infrastructure requirements
# NEVER commit real API keys to version control
